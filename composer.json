{
    "name": "qirolab/laravel-bannable",
    "description": "Laravel bannable package is for blocking and banning Eloquent models.",
    "keywords": [
        "laravel",
        "eloquent",
        "user",
        "ban",
        "block",
        "restrict",
        "forbid"
    ],
    "homepage": "https://qirolab.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Harish Kumar",
            "email": "harish@qirolab.com",
            "homepage": "https://qirolab.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/events": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Qirolab\\Laravel\\Bannable\\": "src"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.5.50",
        "vimeo/psalm": "^5.22|^6.6"
    },
    "autoload-dev": {
        "psr-4": {
            "Qirolab\\Tests\\Laravel\\Bannable\\": "tests/"
        }
    },
    "scripts": {
        "psalm": "vendor/bin/psalm",
        "test": "vendor/bin/phpunit --colors=always",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Qirolab\\Laravel\\Bannable\\BannableServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "funding": [
        {
            "type": "other",
            "url": "https://www.buymeacoffee.com/qirolab"
        }
    ]
}
